{
    "app-id": "org.kiosque.Kiosque",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "kiosque",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=host",
        "--share=network",
        "--talk-name=org.freedesktop.Flatpak"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/kiosque/cargo-home"
        },
        "build-args": [
            "--share=network"
        ]
    },
    "modules": [
        {
            "name": "kiosque",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release",
                "-Dflatpak_backend=cli"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".agents",
                        ".codex",
                        ".aws",
                        ".cache",
                        ".test-results",
                        ".flatpak-builder",
                        "build",
                        "builddir",
                        "rust/target",
                        "AppDir",
                        "repo"
                    ]
                }
            ]
        }
    ]
}
